# OpenAI-compatible 模型服务。密钥、默认模型或任一 Agent 响应不可用时，
# 生产任务会立即失败，不生成降级动画。
LLM_PROVIDER=openai-compatible
OPENAI_BASE_URL=https://your-gateway.example/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4

# 可选的 Agent 专用模型；未设置时使用 LLM_MODEL。
ARTICLE_MODEL=gpt-5.4
ASSET_MODEL=qwen3-vl-flash
EDITORIAL_MODEL=gpt-5.4
COPY_FITTING_MODEL=gpt-5.4
DIRECTOR_MODEL=gpt-5.4
ANIMATION_MODEL=gpt-5.4

LLM_TIMEOUT_SECONDS=90
