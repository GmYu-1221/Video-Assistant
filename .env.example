# 可选：OpenAI Compatible LLM 配置。不填写密钥时，项目仍可使用本地 Mock Provider 渲染。
# 只要中转站实现 OpenAI Chat Completions API，Claude、GPT、DeepSeek、Kimi、Ollama
# 都可通过修改 OPENAI_BASE_URL 和模型名称接入，无需安装对应厂商的 SDK。
LLM_PROVIDER=openai-compatible
# OpenAI Compatible 中转站地址，通常以 /v1 结尾。
OPENAI_BASE_URL=https://your-gateway.example/v1
# 中转站提供的 API Key。请仅填写到本地 .env，勿提交到 Git。
OPENAI_API_KEY=

# 默认模型；未单独设置 Agent 模型时会使用此值。
LLM_MODEL=claude-sonnet-4-20250514
# 导演、Remotion 建议、交互式导演 Chat 和网页素材 Agent 可分别使用不同模型。
DIRECTOR_MODEL=claude-sonnet-4-20250514
REMOTION_MODEL=claude-sonnet-4-20250514
CHAT_MODEL=claude-sonnet-4-20250514
# Web Asset Agent 通过现有 OpenAI-compatible 中转站调用 Gemini 多模态能力。
ASSET_MODEL=gemini-3.6-flash
# Article Understanding Agent；未配置时回退到 ASSET_MODEL。
ARTICLE_MODEL=gemini-3.6-flash
# Dynamic scene layout and visual review both fall back to ASSET_MODEL.
LAYOUT_MODEL=gemini-3.6-flash
VISUAL_CRITIC_MODEL=gemini-3.6-flash
# Visual Critic score below this value requests one localized layout repair.
LAYOUT_QA_THRESHOLD=0.78
# URL 视频素材目标按正文长度动态计算，可按部署资源调整边界。
URL_ASSET_CHARS_PER_IMAGE=650
URL_ASSET_TARGET_MIN=4
URL_ASSET_TARGET_MAX=12
RENDER_AGENT_MODE=safe
